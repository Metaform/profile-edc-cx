{
  "@context": ["https://w3id.org/edc/connector/management/v2"],
  "@type": "PolicyDefinition",
  "@id": "aurora-access-processing",
  "policy": {
    "@type": "Set",
    "permission": [
      {
        "action": "use",
        "constraint": [
          {
            "and": [
              { "leftOperand": "${AURORA_VOCAB}Membership",        "operator": "eq", "rightOperand": "active" },
              { "leftOperand": "${AURORA_VOCAB}DataAccess.level", "operator": "eq", "rightOperand": "processing" }
            ]
          }
        ]
      }
    ]
  }
}
