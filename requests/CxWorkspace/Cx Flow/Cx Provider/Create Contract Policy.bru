meta {
  name: Create Contract Policy
  type: http
  seq: 4
}

post {
  url: {{cpBaseUrl}}/v5/participants/{{provider_id}}/policydefinitions
  body: json
  auth: inherit
}

body:json {
  {
    "@context": [
      "https://w3id.org/edc/connector/management/v2",
      "https://w3id.org/catenax/2025/9/policy/context.jsonld"
    ],
    "@type": "PolicyDefinition",
    "@id": "{{CONTRACT_POLICY_ID}}",
    "policy": {
      "@type": "Set",
      "permission": [
        {
          "action": "use",
          "constraint": [
            {
              "and": [
                {
                  "leftOperand": "FrameworkAgreement",
                  "operator": "eq",
                  "rightOperand": "DataExchangeGovernance:1.0"
                },
                {
                  "leftOperand": "UsagePurpose",
                  "operator": "isAnyOf",
                  "rightOperand": [
                    "cx.pcf.base:1"
                  ]
                },
                {
                  "leftOperand": "DataUsageEndDefinition",
                  "operator": "eq",
                  "rightOperand": "cx.dataUsageEnd.unlimited"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
